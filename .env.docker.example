# ============================================
# Peyker Moda — Production Environment Variables
# ============================================
# Bu dosyayı `.env.docker` olarak kopyalayıp değerleri doldurun:
#   cp .env.docker.example .env.docker
#
# Kullanım:
#   docker compose -f docker-compose.prod.yml --env-file .env.docker up -d
#
# ⚠️ UYARI: Bu dosyayı asla Git'e commit etmeyin!
# ============================================

# Application
NODE_ENV=production

# ---- PostgreSQL ----
POSTGRES_USER=peyker_user
POSTGRES_PASSWORD=          # ⚠️ Güçlü bir şifre belirleyin!
POSTGRES_DB=peyker_db

# ---- Redis ----
REDIS_PASSWORD=             # ⚠️ Güçlü bir şifre belirleyin! (Boş bırakılırsa şifresiz çalışır)

# ---- JWT (Güvenlik) ----
# Aşağıdaki komut ile güçlü bir secret oluşturun:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=                 # ⚠️ ZORUNLU — En az 64 byte random hex
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=           # ⚠️ Google Console'dan alınan Client ID
GOOGLE_CLIENT_SECRET=       # ⚠️ Google Console'dan alınan Client Secret

# ---- CORS ----
# Virgülle ayrılmış izin verilen origin'ler
CORS_ORIGIN=https://peykermoda.com,https://admin.peykermoda.com

# ---- MinIO (S3-compatible Object Storage) ----
MINIO_ROOT_USER=            # ⚠️ Değiştirin! (varsayılan: minioadmin)
MINIO_ROOT_PASSWORD=        # ⚠️ Güçlü bir şifre belirleyin!
S3_BUCKET=peyker-media
S3_REGION=us-east-1

# ---- Upload ----
UPLOAD_BASE_URL=https://peykermoda.com/media

# ---- Admin Hesabı ----
ADMIN_EMAIL=admin@peyker.com
ADMIN_PASSWORD=             # ⚠️ ZORUNLU — Güçlü bir admin şifresi belirleyin!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Peyker

# ---- Frontend Build Args ----
VITE_API_URL=/api
VITE_SOCKET_URL=https://peykermoda.com/api
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID= # ⚠️ Yukarıdaki GOOGLE_CLIENT_ID ile aynı olmalı
NEXT_PUBLIC_SITE_URL=https://peykermoda.com

# ---- HTTP Basic Authentication (Sadece Staging için) ----
# Production ortamında bu değişkenler boş bırakılmalıdır.
# Staging ortamında nginx basic auth varsa bu bilgileri doldurun.
VITE_BASIC_AUTH_USER=
VITE_BASIC_AUTH_PASS=

# ---- Nginx Ports ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
