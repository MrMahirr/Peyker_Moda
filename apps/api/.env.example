# ==========================================
# Peyker Moda API - Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database - PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# S3 / MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=peyker-media
S3_REGION=us-east-1
UPLOAD_BASE_URL=http://localhost:9000/peyker-media

# Security - JWT
# IMPORTANT: Generate strong random secrets for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Default Admin
ADMIN_EMAIL=admin@peyker.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Peyker
ADMIN_FORCE_PASSWORD=false

# CORS - Comma-separated origins
CORS_ORIGIN=http://localhost:3500,http://localhost:5173
