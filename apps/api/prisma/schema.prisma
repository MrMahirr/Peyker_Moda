generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  failedLogins  Int            @default(0)
  lastLoginAt   DateTime?
  lockedUntil   DateTime?
  roleId        String
  blogPosts     BlogPost[]
  customerNotes CustomerNote[]
  heldSales     HeldSale[]
  notifications Notification[]
  orderNotes    OrderNote[]
  orders        Order[]
  posSessions   PosSession[]
  refreshTokens RefreshToken[]
  transactions  Transaction[]
  role          Role           @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  displayName String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  resource String
  action   String
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  sku         String     @unique
  barcode     String?    @unique
  basePrice   Decimal    @db.Decimal(10, 2)
  salePrice   Decimal?   @db.Decimal(10, 2)
  cost        Decimal?   @db.Decimal(10, 2)
  categoryId  String
  brand       String?
  images      Json?      @default("[]")
  viewCount   Int        @default(0)
  isActive    Boolean    @default(true)
  isFeatured  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]
  category    Category   @relation(fields: [categoryId], references: [id])
  variants    Variant[]

  @@index([categoryId])
  @@index([barcode])
  @@index([sku])
  @@map("products")
}

model Variant {
  id        String      @id @default(uuid())
  productId String
  sku       String      @unique
  barcode   String?     @unique
  price     Decimal?    @db.Decimal(10, 2)
  stock     Int         @default(0)
  size      String?
  color     String?
  colorCode String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode])
  @@map("variants")
}

model CustomerGroup {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  discount    Decimal?   @db.Decimal(5, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]

  @@map("customer_groups")
}

model Customer {
  id            String            @id @default(uuid())
  firstName     String
  lastName      String
  email         String?
  phone         String?
  address       String?
  city          String?
  district      String?
  postalCode    String?
  notes         String?
  groupId       String?
  totalSpent    Decimal           @default(0) @db.Decimal(12, 2)
  orderCount    Int               @default(0)
  lastOrderDate DateTime?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  birthDate     DateTime?
  gender        Gender?
  loyaltyPoints Int               @default(0)
  loyaltyTierId String?
  password      String?
  googleId      String?           @unique
  addresses     CustomerAddress[]
  customerNotes CustomerNote[]
  group         CustomerGroup?    @relation(fields: [groupId], references: [id])
  loyaltyTier   LoyaltyTier?      @relation(fields: [loyaltyTierId], references: [id])
  favorites     Favorite[]
  heldSales     HeldSale[]
  orders        Order[]

  @@index([groupId])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  title      String
  fullName   String
  phone      String
  address    String
  city       String
  district   String
  postalCode String?
  isDefault  Boolean  @default(false)
  type       String   @default("home")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model Favorite {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("favorites")
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  customerId        String?
  userId            String?
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  source            OrderSource   @default(POS)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  shippingCost      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  couponCode        String?
  notes             String?
  shippingAddress   Json?
  cargoTrackingCode String?
  cargoProvider     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  Installment       Installment[]
  invoice           Invoice?
  items             OrderItem[]
  OrderNote         OrderNote[]
  customer          Customer?     @relation(fields: [customerId], references: [id])
  user              User?         @relation(fields: [userId], references: [id])
  payments          Payment[]
  returns           Return[]
  shipments         Shipment[]
  transactions      Transaction[]

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Carrier {
  id        String         @id @default(uuid())
  name      String
  code      CarrierCode    @unique
  apiKey    String?
  isActive  Boolean        @default(true)
  logo      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  shipments Shipment[]
  rates     ShippingRate[]

  @@index([isActive])
  @@map("carriers")
}

model Shipment {
  id                String         @id @default(uuid())
  orderId           String
  carrierId         String
  trackingNumber    String         @unique
  status            ShipmentStatus @default(PREPARING)
  recipientName     String
  recipientPhone    String
  recipientAddress  String
  weight            Decimal?       @db.Decimal(10, 2)
  desi              Decimal?       @db.Decimal(10, 2)
  shippingCost      Decimal        @default(0) @db.Decimal(10, 2)
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  carrier           Carrier        @relation(fields: [carrierId], references: [id])
  order             Order          @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([carrierId])
  @@index([status])
  @@index([createdAt])
  @@map("shipments")
}

model ShippingRate {
  id        String   @id @default(uuid())
  carrierId String
  minWeight Decimal  @db.Decimal(10, 2)
  maxWeight Decimal  @db.Decimal(10, 2)
  zone      String
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  carrier   Carrier  @relation(fields: [carrierId], references: [id])

  @@unique([carrierId, minWeight, maxWeight, zone])
  @@index([carrierId])
  @@index([isActive])
  @@map("shipping_rates")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model Return {
  id           String       @id @default(uuid())
  orderId      String
  reason       String
  status       ReturnStatus @default(PENDING)
  refundAmount Decimal      @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        ReturnItem[]
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("returns")
}

model ReturnItem {
  id        String  @id @default(uuid())
  returnId  String
  variantId String
  quantity  Int
  reason    String?
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_items")
}

model PosSession {
  id                String    @id @default(uuid())
  userId            String
  openingBalance    Decimal   @db.Decimal(12, 2)
  closingBalance    Decimal?  @db.Decimal(12, 2)
  expectedBalance   Decimal?  @db.Decimal(12, 2)
  difference        Decimal?  @db.Decimal(12, 2)
  totalSales        Decimal?  @db.Decimal(12, 2)
  totalTransactions Int?
  notes             String?
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("pos_sessions")
}

model HeldSale {
  id         String    @id @default(uuid())
  userId     String
  customerId String?
  items      Json
  notes      String?
  createdAt  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("held_sales")
}

model Transaction {
  id              String          @id @default(uuid())
  type            TransactionType
  category        String?
  amount          Decimal         @db.Decimal(12, 2)
  description     String?
  reference       String?
  paymentMethod   PaymentMethod?
  orderId         String?
  transactionDate DateTime        @default(now())
  userId          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  order           Order?          @relation(fields: [orderId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([transactionDate])
  @@map("transactions")
}

model Invoice {
  id           String        @id @default(uuid())
  invoiceNo    String        @unique
  orderId      String?       @unique
  customerName String
  taxId        String?
  taxOffice    String?
  amount       Decimal       @db.Decimal(10, 2)
  taxRate      Int           @default(20)
  taxAmount    Decimal       @db.Decimal(10, 2)
  pdfUrl       String?
  status       InvoiceStatus @default(DRAFT)
  issueDate    DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        Json?
  order        Order?        @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

model Campaign {
  id            String       @id @default(uuid())
  name          String
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minPurchase   Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  categoryIds   Json?        @default("[]")
  productIds    Json?        @default("[]")
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  code          String?      @unique

  @@map("campaigns")
}

model Coupon {
  id                    String       @id @default(uuid())
  code                  String       @unique
  description           String?
  discountType          DiscountType
  discountValue         Decimal      @db.Decimal(10, 2)
  minPurchase           Decimal?     @db.Decimal(10, 2)
  maxDiscount           Decimal?     @db.Decimal(10, 2)
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usageCount            Int          @default(0)
  startDate             DateTime
  endDate               DateTime
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("coupons")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  key       String   @unique
  url       String
  mimetype  String
  size      Int
  folder    String
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([mimetype])
  @@map("media")
}

model Supplier {
  id          String           @id @default(uuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  taxNumber   String?
  taxOffice   String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  account     SupplierAccount?

  @@map("suppliers")
}

model CashRegister {
  id        String   @id @default(uuid())
  name      String
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cash_registers")
}

model BankAccount {
  id          String   @id @default(uuid())
  bankName    String
  accountName String
  iban        String?
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  currency    String   @default("TRY")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bank_accounts")
}

model SupplierAccount {
  id         String   @id @default(uuid())
  supplierId String   @unique
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_accounts")
}

model Check {
  id          String      @id @default(uuid())
  checkNumber String      @unique
  bankName    String
  amount      Decimal     @db.Decimal(12, 2)
  dueDate     DateTime
  status      CheckStatus @default(PORTFOLIO)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("checks")
}

model Installment {
  id        String    @id @default(uuid())
  orderId   String
  amount    Decimal   @db.Decimal(10, 2)
  dueDate   DateTime
  isPaid    Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  order     Order     @relation(fields: [orderId], references: [id])

  @@map("installments")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@map("customer_notes")
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("order_notes")
}

model LoyaltyTier {
  id           String     @id @default(uuid())
  name         String
  minPoints    Int
  discountRate Decimal    @db.Decimal(5, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  customers    Customer[]

  @@map("loyalty_tiers")
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  authorId    String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
}

model Page {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  link      String?
  position  String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model PriceList {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("price_lists")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum OrderSource {
  POS
  ONLINE
  PHONE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  PARTIAL
  REFUNDED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CarrierCode {
  ARAS
  MNG
  YURTICI
  PTT
  SURAT
  UPS
  OTHER
}

enum ShipmentStatus {
  PREPARING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
  PAID
}

enum CheckStatus {
  PORTFOLIO
  CASHED
  BOUNCED
  RETURNED
}
