{
  "name": "peyker-moda",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:seed": "pnpm --filter api run db:seed",
    "db:migrate:dev": "pnpm --filter api run migrate:dev",
    "db:migrate:deploy": "pnpm --filter api run migrate:deploy",
    "db:backup": "node scripts/db-backup.js"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
